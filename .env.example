# Copy this file to .env for local development.
# Required values are marked [required]; optional values are marked [optional].
# These placeholders are for local development only and must not be used in production.

# Project [required]
# Compose project name used to group local resources.
COMPOSE_PROJECT_NAME=suaposta

# PostgreSQL contract [required for Task 1.2]
# Hostname used by containers to reach PostgreSQL through Compose networking.
POSTGRES_HOST=postgres
# PostgreSQL port inside the Compose network.
POSTGRES_PORT=5432
# PostgreSQL port published on the local machine.
POSTGRES_HOST_PORT=5432
# Local-development PostgreSQL administrative user.
POSTGRES_SUPERUSER=suaposta_admin
# Local-development PostgreSQL administrative password placeholder.
POSTGRES_SUPERUSER_PASSWORD=change_me
# Maintenance database used by the PostgreSQL administrative user.
POSTGRES_SUPERUSER_DB=postgres

# Auth database [required for Task 1.2]
# Database name owned by auth-service.
AUTH_DB_NAME=suaposta_auth
# Database user owned by auth-service.
AUTH_DB_USER=suaposta_auth
# Local-development password placeholder for auth-service's database user.
AUTH_DB_PASSWORD=change_me_auth

# Betting database [required for Task 1.2]
# Database name owned by betting-service.
BETTING_DB_NAME=suaposta_betting
# Database user owned by betting-service.
BETTING_DB_USER=suaposta_betting
# Local-development password placeholder for betting-service's database user.
BETTING_DB_PASSWORD=change_me_betting

# Analytics database [required for Task 1.2]
# Database name owned by analytics-service.
ANALYTICS_DB_NAME=suaposta_analytics
# Database user owned by analytics-service.
ANALYTICS_DB_USER=suaposta_analytics
# Local-development password placeholder for analytics-service's database user.
ANALYTICS_DB_PASSWORD=change_me_analytics

# RabbitMQ contract [required for Task 1.3]
# Hostname used by containers to reach RabbitMQ through Compose networking.
RABBITMQ_HOST=rabbitmq
# AMQP port inside the Compose network.
RABBITMQ_AMQP_PORT=5672
# AMQP port published on the local machine.
RABBITMQ_HOST_AMQP_PORT=5672
# Management interface port published on the local machine.
RABBITMQ_MANAGEMENT_HOST_PORT=15672
# Local-development RabbitMQ user.
RABBITMQ_DEFAULT_USER=suaposta
# Local-development RabbitMQ password placeholder.
RABBITMQ_DEFAULT_PASS=change_me

# Local application runtime [reference placeholders]
# These variables are not consumed by the current Compose-only services. Supply
# only the variables for the Spring process being launched; see
# docs/infrastructure.md for the service-specific grouping.

# Shared Auth/Gateway signing secret [required for auth-service and api-gateway]
# Replace only in the ignored local .env; never commit a real secret.
JWT_SECRET=replace_with_a_local_development_jwt_secret

# API Gateway downstream service URLs [optional; defaults shown]
AUTH_SERVICE_URL=http://127.0.0.1:8081
BETTING_SERVICE_URL=http://127.0.0.1:8082
ANALYTICS_SERVICE_URL=http://127.0.0.1:8083

# Auth service host-process datasource [required when running auth-service]
AUTH_DB_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/suaposta_auth

# Betting service host-process datasource [required when running betting-service]
BETTING_DB_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/suaposta_betting

# Analytics service host-process datasource [required when running analytics-service]
# Spring relaxed binding for spring.datasource.url/username/password.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/suaposta_analytics
SPRING_DATASOURCE_USERNAME=suaposta_analytics
SPRING_DATASOURCE_PASSWORD=change_me_analytics

# RabbitMQ for Betting and Analytics host processes [required for event flow]
# Spring relaxed binding for spring.rabbitmq.*.
SPRING_RABBITMQ_HOST=127.0.0.1
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=suaposta
SPRING_RABBITMQ_PASSWORD=change_me
